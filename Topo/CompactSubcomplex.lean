import Topo.Subcomplex
import Mathlib.Topology.DiscreteSubset
import Mathlib.Geometry.Convex.ConvexSpace.CompactSpaceStdSimplex

/-! # Compact subsets lie in finite subcomplexes -/

noncomputable section
open Topology Convexity

namespace Topo.Complex
universe u
variable {V : Type u} (K : Topo.Complex V)

/-- The subcomplex generated by finitely many faces. -/
def generated (S : Finset K.Face) : Topo.Complex V where
  faces := {t | t = ∅ ∨ ∃ s ∈ S, t ⊆ s.1}
  empty_mem := Or.inl rfl
  downward hst ht := by
    rcases ht with rfl | ⟨s, hs, ht⟩
    · exact Or.inl (Finset.subset_empty.mp hst)
    · exact Or.inr ⟨s, hs, hst.trans ht⟩

theorem generated_subset (S : Finset K.Face) : (K.generated S).faces ⊆ K.faces := by
  rintro t (rfl | ⟨s, _, ht⟩)
  · exact K.empty_mem
  · exact K.downward ht s.2

theorem finite_generated (S : Finset K.Face) : (K.generated S).faces.Finite := by
  classical
  have he : (K.generated S).faces = {∅} ∪ ⋃ s ∈ S, (↑s.1.powerset : Set (Finset V)) := by
    ext t
    simp [generated]
  rw [he]
  exact (Set.finite_singleton _).union
    (S.finite_toSet.biUnion fun s _ ↦ s.1.powerset.finite_toSet)

/-- A set containing at most one point in each open simplex is closed. -/
theorem isClosed_of_support_injOn {A : Set K.Realization}
    (hA : Set.InjOn (fun x : K.Realization ↦ x.1.weights.support) A) : IsClosed A := by
  classical
  rw [K.isClosed_iff]
  intro s
  let : T2Space (StdSimplex ℝ s.1) := (K.isEmbedding_faceInclusion s).t2Space
  apply Set.Finite.isClosed
  apply Set.Finite.of_injOn
    (f := fun w : StdSimplex ℝ s.1 ↦ (K.faceInclusion s w).1.weights.support)
    (t := (↑s.1.powerset : Set (Finset V)))
  · intro w _
    exact Finset.mem_powerset.mpr (support_map_val_subset _ _)
  · intro w hw z hz he
    exact (K.isEmbedding_faceInclusion s).injective (hA hw hz he)
  · exact s.1.powerset.finite_toSet

theorem isDiscrete_of_support_injOn {A : Set K.Realization}
    (hA : Set.InjOn (fun x : K.Realization ↦ x.1.weights.support) A) : IsDiscrete A := by
  rw [isDiscrete_iff_forall_mem_exists_isClosed]
  intro B hB
  exact ⟨B, K.isClosed_of_support_injOn (hA.mono hB), Set.inter_eq_left.mpr hB⟩

/-- A compact set meets only finitely many open simplices. -/
theorem IsCompact.finite_supports {C : Set K.Realization} (hC : IsCompact C) :
    ((fun x : K.Realization ↦ x.1.weights.support) '' C).Finite := by
  classical
  let S := (fun x : K.Realization ↦ x.1.weights.support) '' C
  have hc (s : S) : ∃ x ∈ C, x.1.weights.support = s.1 := s.2
  choose f hfC hfs using hc
  have hinj : Function.Injective f := by
    intro s t h
    apply Subtype.ext
    exact (hfs s).symm.trans ((congrArg (fun x : K.Realization ↦ x.1.weights.support) h).trans
      (hfs t))
  have hA : Set.InjOn (fun x : K.Realization ↦ x.1.weights.support) (Set.range f) := by
    rintro x ⟨s, rfl⟩ y ⟨t, rfl⟩ h
    congr 1
    exact Subtype.ext ((hfs s).symm.trans (h.trans (hfs t)))
  have hcompact : IsCompact (Set.range f) := hC.of_isClosed_subset
    (K.isClosed_of_support_injOn hA) (by rintro _ ⟨s, rfl⟩; exact hfC s)
  have hfinite := hcompact.finite (K.isDiscrete_of_support_injOn hA)
  have : Finite S := Set.finite_range_iff hinj |>.mp hfinite
  exact Set.toFinite S

/-- Every compact subset is contained in a finite subcomplex realization. -/
theorem IsCompact.exists_finite_subcomplex {C : Set K.Realization} (hC : IsCompact C) :
    ∃ F : Topo.Complex V, ∃ hFK : F.faces ⊆ K.faces,
      F.faces.Finite ∧ C ⊆ Set.range (inclusion hFK) := by
  classical
  have hf := IsCompact.finite_supports K hC
  let S : Finset K.Face := hf.toFinset.attach.map
    ⟨fun (s : ↥hf.toFinset) ↦ ⟨s.1, by
      obtain ⟨x, _, hx⟩ := hf.mem_toFinset.mp s.2
      rw [← hx]
      exact x.2⟩, fun s t h ↦ Subtype.ext (congrArg (fun z : K.Face ↦ z.1) h)⟩
  refine ⟨K.generated S, K.generated_subset S, K.finite_generated S, ?_⟩
  intro x hx
  rw [mem_range_inclusion]
  right
  refine ⟨⟨x.1.weights.support, x.2⟩, ?_, Finset.Subset.refl _⟩
  simp only [S, Finset.mem_map, Finset.mem_attach, true_and]
  refine ⟨⟨x.1.weights.support, hf.mem_toFinset.mpr ⟨x, hx, rfl⟩⟩, rfl⟩

end Topo.Complex
